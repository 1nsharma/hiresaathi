// Prisma Schema for HireSaathi AI Platform
// Complete database structure for all modules

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  avatar        String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  workspaces    WorkspaceMember[]
  apiKeys       ApiKey[]
  sessions      Session[]
  auditLogs     AuditLog[]
  
  @@index([email])
  @@index([role])
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  key       String   @unique
  scopes    String[] // ["read", "write", "admin"]
  expiresAt DateTime?
  lastUsedAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([key])
}

// ============================================
// WORKSPACE & TEAM MANAGEMENT
// ============================================

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  plan        PlanType @default(FREE)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  members     WorkspaceMember[]
  projects    Project[]
  brand       Brand?
  
  @@index([slug])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

// ============================================
// BRAND IQ - Brand Intelligence
// ============================================

model Brand {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  name            String
  website         String?
  logo            String?
  tagline         String?
  description     String?
  
  // Brand Voice & Tone
  voiceTone       String?  // e.g., "Professional, innovative, data-driven"
  personality     String[] // e.g., ["Innovative", "Trustworthy"]
  targetAudience  String?
  languages       String[] // e.g., ["English", "Hindi"]
  brandColors     String[] // Hex codes
  
  // Extracted Intelligence
  products        String[]
  services        String[]
  differentiators String[]
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contents  Content[]
  
  @@index([workspaceId])
}

// ============================================
// AI MARKETING MODULE
// ============================================

model Agent {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  category    String   // "Content Marketing", "Social Media", etc.
  icon        String?
  color       String?
  
  // Tool Requirements
  requiredTools String[] // Composio tool IDs
  
  // Configuration
  systemPrompt  String?
  inputSchema   Json?
  outputSchema  Json?
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  executions AgentExecution[]
  
  @@index([category])
  @@index([slug])
}

model AgentExecution {
  id          String           @id @default(cuid())
  agentId     String
  workspaceId String
  userId      String
  
  input       String
  context     Json?
  status      ExecutionStatus  @default(PENDING)
  
  // Execution Steps
  steps       Json             // Array of execution steps
  
  // Result
  output      Json?
  error       String?
  
  // Metrics
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  durationMs  Int?
  
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@index([agentId])
  @@index([workspaceId])
  @@index([userId])
  @@index([status])
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Content {
  id          String        @id @default(cuid())
  workspaceId String
  brandId     String?
  userId      String
  
  title       String
  content     String        // Markdown or HTML
  contentType ContentType
  
  // Metadata
  keywords    String[]
  seoScore    Int?
  wordCount   Int?
  
  // Status
  status      ContentStatus @default(DRAFT)
  
  // Scheduling
  scheduledAt DateTime?
  publishedAt DateTime?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  brand     Brand?    @relation(fields: [brandId], references: [id])
  approvals Approval[]
  
  @@index([workspaceId])
  @@index([brandId])
  @@index([status])
  @@index([scheduledAt])
}

enum ContentType {
  BLOG_POST
  SOCIAL_POST
  EMAIL
  AD_COPY
  PRESS_RELEASE
  VIDEO_SCRIPT
  CASE_STUDY
  OTHER
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Approval {
  id          String        @id @default(cuid())
  contentId   String
  reviewerId  String
  status      ApprovalStatus @default(PENDING)
  comments    String?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())
  
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  
  @@index([contentId])
  @@index([reviewerId])
  @@index([status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId  String
  userId       String
  
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  
  // Channels
  channels    String[]       // ["email", "social", "ads"]
  
  // Budget
  budget      Decimal?
  spent       Decimal        @default(0)
  
  // Timeline
  startDate   DateTime?
  endDate     DateTime?
  
  // Metrics
  reach       Int            @default(0)
  conversions Int            @default(0)
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  @@index([workspaceId])
  @@index([status])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

// ============================================
// AI HIRING MODULE
// ============================================

model Job {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  
  title       String
  description String
  requirements String[]
  benefits    String[]
  
  location    String?
  type        JobType    @default(FULL_TIME)
  salary      String?
  currency    String     @default("INR")
  
  status      JobStatus  @default(DRAFT)
  
  // Metrics
  applicants  Int        @default(0)
  views       Int        @default(0)
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  candidates  JobCandidate[]
  
  @@index([workspaceId])
  @@index([status])
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED
}

model Candidate {
  id          String           @id @default(cuid())
  workspaceId  String
  
  name        String
  email       String
  phone       String?
  resume      String?          // File URL
  linkedin    String?
  portfolio   String?
  
  // AI Processing
  skills      String[]
  experience  Int?             // Years
  education   String?
  
  // AI Matching
  aiScore     Int?             // 0-100
  aiAnalysis  Json?
  
  status      CandidateStatus  @default(NEW)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  jobs        JobCandidate[]
  
  @@index([workspaceId])
  @@index([email])
  @@index([status])
}

enum CandidateStatus {
  NEW
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model JobCandidate {
  id          String   @id @default(cuid())
  jobId       String
  candidateId String
  
  matchScore  Int?
  appliedAt   DateTime @default(now())
  status      String   @default("APPLIED")
  
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
}

// ============================================
// AI SUPPORT MODULE
// ============================================

model Ticket {
  id          String       @id @default(cuid())
  workspaceId String
  userId      String?      // Customer user ID
  agentId     String?      // Support agent ID
  
  subject     String
  description String
  priority    Priority     @default(MEDIUM)
  status      TicketStatus @default(OPEN)
  
  // AI Processing
  aiResponse  String?
  aiConfidence Float?
  
  // Resolution
  resolution  String?
  resolvedAt  DateTime?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  messages    TicketMessage[]
  
  @@index([workspaceId])
  @@index([status])
  @@index([priority])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String?
  senderType String  // "user", "agent", "ai"
  message   String
  createdAt DateTime @default(now())
  
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@index([ticketId])
}

// ============================================
// AI AUTOMATION MODULE
// ============================================

model Workflow {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  
  name        String
  description String?
  
  // Trigger
  triggerType String         // "webhook", "schedule", "event"
  triggerConfig Json?
  
  // Steps
  steps       Json           // Array of workflow steps
  
  status      WorkflowStatus @default(DRAFT)
  
  // Metrics
  runs        Int            @default(0)
  successRate Float          @default(0)
  lastRunAt   DateTime?
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  executions  WorkflowExecution[]
  
  @@index([workspaceId])
  @@index([status])
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model WorkflowExecution {
  id          String           @id @default(cuid())
  workflowId  String
  
  status      ExecutionStatus  @default(PENDING)
  input       Json?
  output      Json?
  error       String?
  
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  durationMs  Int?
  
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  @@index([workflowId])
  @@index([status])
}

// ============================================
// MCP & INTEGRATIONS (COMPOSIO)
// ============================================

model ToolConnection {
  id            String   @id @default(cuid())
  workspaceId   String
  userId        String
  
  // Composio Integration
  appId         String   // Composio app ID (e.g., "github", "gmail")
  appName       String
  appIcon       String?
  category      String
  
  connectionId  String   @unique // Composio connection ID
  status        ConnectionStatus @default(ACTIVE)
  
  // Metadata
  connectedAt   DateTime @default(now())
  lastUsedAt    DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([workspaceId, appId])
  @@index([workspaceId])
  @@index([appId])
  @@index([status])
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

// ============================================
// ANALYTICS & AUDIT
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  
  action      String   // "user.login", "content.create", etc.
  resource    String?  // "content", "job", "ticket", etc.
  resourceId  String?
  
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
  
  user User? @relation(fields: [userId], references: [id])
  
  @@index([workspaceId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  
  eventType   String   // "page_view", "button_click", "api_call"
  eventName   String
  properties  Json?
  
  createdAt   DateTime @default(now())
  
  @@index([workspaceId])
  @@index([eventType])
  @@index([createdAt])
}

// ============================================
// ASSET MANAGEMENT
// ============================================

model Asset {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  
  name        String
  type        String   // "image", "video", "document", etc.
  mimeType    String
  size        Int      // bytes
  url         String
  
  // Metadata
  tags        String[]
  folder      String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([workspaceId])
  @@index([type])
  @@index([folder])
}
